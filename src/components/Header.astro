---
import Icon from './Icon.astro';
const pathname = Astro.url.pathname;
const nav = [
  ['Home', '/'], ['Learn', '/learn'], ['Projects', '/projects'], ['Tutorials', '/tutorials'],
  ['Blog', '/blog'], ['Community', '/community'], ['Resources', '/resources'], ['About', '/about']
];
---
<header class="site-header" data-header>
  <div class="shell nav-wrap">
    <a class="brand" href="/" aria-label="Academy4Tech home">
      <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>Academy<span>4</span>Tech</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {nav.map(([label, href]) => <a href={href} aria-current={pathname === href || (href !== '/' && pathname.startsWith(href)) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="nav-actions">
      <a class="icon-button" href="/search" aria-label="Search Academy4Tech"><Icon name="search" /></a>
      <a class="button button-small" href="/courses/interest">Find my course <Icon name="arrow" size={18} /></a>
      <button class="icon-button menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" data-menu-button><Icon name="menu" /></button>
    </div>
  </div>
  <nav id="mobile-nav" class="mobile-nav shell" aria-label="Mobile navigation" hidden data-mobile-nav>
    {nav.map(([label, href]) => <a href={href} aria-current={pathname === href || (href !== '/' && pathname.startsWith(href)) ? 'page' : undefined}>{label}</a>)}
    <a class="button" href="/courses/interest">Find my course <Icon name="arrow" size={18} /></a>
  </nav>
</header>
<script>
  const button = document.querySelector('[data-menu-button]');
  const menu = document.querySelector('[data-mobile-nav]');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    if (menu instanceof HTMLElement) menu.hidden = open;
  });
</script>
