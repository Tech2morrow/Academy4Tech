import BaseLayout from '@/layouts/BaseLayout.astro';import Icon from '@/components/Icon.astro';
---
<BaseLayout title="Page not found" description="The requested Academy4Tech page could not be found." noindex>
  <section class="hero"><div class="shell" style="text-align:center;max-width:780px"><div class="eyebrow" style="justify-content:center">Error 404</div><h1>That circuit is <span style="color:var(--cyan)">open.</span></h1><p style="margin:24px auto 0;max-width:620px">The page may have moved during the Academy4Tech rebuild. Search the new library or return to the homepage.</p><div class="hero-actions" style="justify-content:center"><a class="button" href="/">Go home <Icon name="arrow" size={18}/></a><a class="button button-secondary" href="/search">Search the site</a></div></div></section>
</BaseLayout>
