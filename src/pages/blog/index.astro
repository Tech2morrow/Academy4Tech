---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ContentCard from '@/components/ContentCard.astro';
import Newsletter from '@/components/Newsletter.astro';
import { isPublished, slugify } from '@/utils/content';
const posts=(await getCollection('blog')).filter(isPublished).sort((a,b)=>b.data.publishedDate.valueOf()-a.data.publishedDate.valueOf());
const featured=posts.find(item=>item.data.featured)??posts[0];
const categories=[...new Set(posts.map(item=>item.data.category))].sort();
const tags=[...new Set(posts.flatMap(item=>item.data.tags))].sort();
---
<BaseLayout title="Engineering Blog" description="Academy4Tech articles on robotics, IoT, programming, autonomous systems and practical engineering.">
  <section class="page-hero"><div class="shell"><Breadcrumbs items={[{label:'Home',href:'/'},{label:'Blog'}]}/><div class="page-hero-grid"><div><div class="eyebrow">Engineering journal</div><h1>Ideas for people who build.</h1><p>Technical notes, project updates and practical ways to connect software, electronics and robotics.</p></div><a class="button button-secondary" href="/rss.xml">Follow via RSS</a></div></div></section>
  {featured&&<section class="section-tight"><div class="shell"><ContentCard featured href={`/blog/${featured.id}`} title={featured.data.title} description={featured.data.description} category="Featured article" meta={featured.data.readingTime} tags={featured.data.tags} icon="robot" action="Read featured article" /></div></section>}
  <section class="section"><div class="shell"><div class="section-head"><div><div class="eyebrow">Latest writing</div><h2>All articles.</h2></div><p>Filter by category or tag, or search titles and summaries.</p></div>
    <div class="filter-bar"><label for="blog-search">Find an article</label><input id="blog-search" type="search" placeholder="Search articles" data-blog-search/><label class="sr-only" for="blog-category">Category</label><select id="blog-category" data-blog-category><option value="">All categories</option>{categories.map(value=><option value={slugify(value)}>{value}</option>)}</select><label class="sr-only" for="blog-tag">Tag</label><select id="blog-tag" data-blog-tag><option value="">All tags</option>{tags.map(value=><option value={slugify(value)}>{value}</option>)}</select></div>
    <div class="content-grid" data-blog-grid>{posts.map(entry=><div data-blog-item data-category={slugify(entry.data.category)} data-tags={entry.data.tags.map(slugify).join(' ')} data-search={`${entry.data.title} ${entry.data.description} ${entry.data.category} ${entry.data.tags.join(' ')}`.toLowerCase()}><ContentCard href={`/blog/${entry.id}`} title={entry.data.title} description={entry.data.description} category={entry.data.category} meta={entry.data.readingTime} tags={entry.data.tags} action="Read article" /></div>)}</div>
    <p class="empty-state" hidden data-blog-empty>No articles match those filters.</p><nav class="filter-bar" aria-label="Article pagination" data-pagination style="margin-top:28px"></nav>
  </div></section>
  <section class="section surface-section"><div class="shell"><Newsletter /></div></section>
</BaseLayout>
<script>
  const pageSize=6;let page=1;
  const updateBlog=()=>{const search=document.querySelector('[data-blog-search]');const category=document.querySelector('[data-blog-category]');const tag=document.querySelector('[data-blog-tag]');const q=search instanceof HTMLInputElement?search.value.toLowerCase():'';const c=category instanceof HTMLSelectElement?category.value:'';const t=tag instanceof HTMLSelectElement?tag.value:'';const matches=[...document.querySelectorAll('[data-blog-item]')].filter(item=>item instanceof HTMLElement&&(!q||item.dataset.search?.includes(q))&&(!c||item.dataset.category===c)&&(!t||item.dataset.tags?.split(' ').includes(t)));const pages=Math.max(1,Math.ceil(matches.length/pageSize));page=Math.min(page,pages);document.querySelectorAll('[data-blog-item]').forEach(item=>{if(item instanceof HTMLElement)item.hidden=true;});matches.forEach((item,index)=>{if(item instanceof HTMLElement)item.hidden=index>=(page-1)*pageSize&&index<page*pageSize?false:true;});const empty=document.querySelector('[data-blog-empty]');if(empty instanceof HTMLElement)empty.hidden=matches.length>0;const nav=document.querySelector('[data-pagination]');if(nav){nav.replaceChildren();for(let i=1;i<=pages;i++){const button=document.createElement('button');button.className=i===page?'button button-small':'button button-small button-secondary';button.textContent=String(i);button.setAttribute('aria-label',`Page ${i}`);button.addEventListener('click',()=>{page=i;updateBlog();});nav.append(button);}}};
  ['[data-blog-search]','[data-blog-category]','[data-blog-tag]'].forEach(selector=>document.querySelector(selector)?.addEventListener('input',()=>{page=1;updateBlog();}));updateBlog();
</script>
