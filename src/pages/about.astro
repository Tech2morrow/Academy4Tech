---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ConnectLinks from '@/components/ConnectLinks.astro';
import { SITE } from '@/data/site';
---
<BaseLayout title="About" description="About Academy4Tech and its practical engineering education mission.">
  <section class="page-hero">
    <div class="shell">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
      <div class="eyebrow">About {SITE.name}</div>
      <h1>Engineering knowledge, made practical.</h1>
      <p>Academy4Tech documents robotics, IoT, programming and embedded engineering in a way that helps learners move from an idea to a tested system.</p>
    </div>
  </section>
  <section class="section">
    <div class="shell">
      <div class="article-shell" style="padding:0">
        <article class="article prose">
          <h2>About the author</h2>
          <p>Muhammed Nabeel describes his work as centered on mechatronic systems, product development, prototyping and commissioning, with a particular interest in robotics and autonomous systems.</p>
          <p>The profile on the original website records experience contributing to unmanned ground-vehicle platforms including SCORPIO-M and SCORPIO-S, mechatronic event systems including DNAxs and Sliding Screen, and Industrial Internet of Things and mobility prototypes. These details are preserved from the author's self-published profile and are not presented as independent third-party endorsements.</p>
          <h2>Teaching approach</h2>
          <p>The original Academy4Tech profile emphasizes a collaborative, inclusive relationship between educator and learner. The rebuilt platform continues that approach through open project records, practical sequences and clear links to source material.</p>
          <h2>What Academy4Tech covers</h2>
          <p>Core subjects include Python, IoT, Arduino, Raspberry Pi, C++, autonomous robotics, ROS, PCB design, Android interfaces, 3D modelling and printing, OpenCV, computer vision and machine learning.</p>
          <h2 id="gallery">Preserving the original work</h2>
          <p>Selected project and course images from the former Google Site are now stored locally and used on the matching learning and project pages with descriptive alternative text. The former event gallery also named <strong>STEP 2020</strong>, <strong>GITEX 2019</strong> and <strong>Young Professionals in Space</strong>.</p>
          <p><a href="/apps">Explore Android apps developed by Academy4Tech</a>, including educational experiences and practical tools.</p>
        </article>
        <aside class="article-aside about-connect-aside">
          <div class="about-connect-panel">
            <div class="eyebrow">Connect</div>
            <h2>Continue the conversation.</h2>
            <p>Reach Academy4Tech directly or follow the latest projects.</p>
            <ConnectLinks compact />
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
