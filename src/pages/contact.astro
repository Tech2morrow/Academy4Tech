---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ConnectLinks from '@/components/ConnectLinks.astro';
import Icon from '@/components/Icon.astro';
import { SITE } from '@/data/site';
---
<BaseLayout title="Connect" description="Connect with Academy4Tech by email, LinkedIn, GitHub or YouTube.">
  <section class="page-hero connect-hero">
    <div class="shell">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Connect' }]} />
      <div class="page-hero-grid">
        <div>
          <div class="eyebrow">Let’s connect</div>
          <h1>Build, learn and share ideas.</h1>
          <p>Questions about the learning resources, Android apps or engineering projects are welcome. Choose the channel that works best for you.</p>
          <div class="hero-actions">
            <a class="button" href={`mailto:${SITE.email}`}><Icon name="mail" size={19} /> Email Academy4Tech</a>
            <a class="button button-secondary" href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="network" size={19} /> Follow on LinkedIn</a>
          </div>
        </div>
        <div class="connect-orbit" aria-hidden="true">
          <span class="connect-orbit-core"><Icon name="network" size={42} /></span>
          <span class="connect-orbit-node connect-orbit-node-one"><Icon name="mail" size={22} /></span>
          <span class="connect-orbit-node connect-orbit-node-two"><Icon name="github" size={22} /></span>
          <span class="connect-orbit-node connect-orbit-node-three"><Icon name="play" size={22} /></span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell connect-layout">
      <article class="connect-email-card">
        <span class="connect-email-icon"><Icon name="mail" size={32} /></span>
        <div class="eyebrow">Direct email</div>
        <h2>Start a conversation.</h2>
        <p>For learning questions, collaborations and project enquiries, write to the Academy4Tech inbox.</p>
        <a class="connect-email-primary" href={`mailto:${SITE.email}`}>{SITE.email}<Icon name="arrow" size={18} /></a>
        <div class="connect-email-alternate"><span>Alternative email</span><a href={`mailto:${SITE.alternateEmail}`}>{SITE.alternateEmail}</a></div>
      </article>

      <div class="connect-channel-panel">
        <div class="section-head">
          <div><div class="eyebrow">Public channels</div><h2>Find Academy4Tech online.</h2></div>
          <p>Explore project code, follow new work and connect professionally through these verified profiles.</p>
        </div>
        <ConnectLinks includeEmail={false} />
      </div>
    </div>
  </section>
</BaseLayout>
