---
import BaseLayout from '@/layouts/BaseLayout.astro';import Breadcrumbs from '@/components/Breadcrumbs.astro';import Icon from '@/components/Icon.astro';import {SITE} from '@/data/site';
---
<BaseLayout title="Contact" description="Contact Academy4Tech through its confirmed public channels.">
  <section class="page-hero"><div class="shell"><Breadcrumbs items={[{label:'Home',href:'/'},{label:'Contact'}]}/><div class="eyebrow">Get in touch</div><h1>Talk engineering.</h1><p>Use one of the confirmed public channels below. No contact form or unverified email address has been added.</p></div></section>
  <section class="section"><div class="shell"><div class="content-grid"><article class="content-card"><div class="card-visual"><span>Professional profile</span><Icon name="network" size={44}/></div><div class="card-body"><h3>LinkedIn</h3><p>Connect with Muhammed Nabeel through the profile linked on the original Academy4Tech site.</p><a class="text-link" href={SITE.social.linkedinOwner} target="_blank" rel="noopener noreferrer">Open LinkedIn <Icon name="external" size={17}/></a></div></article><article class="content-card"><div class="card-visual"><span>Project code</span><Icon name="github" size={44}/></div><div class="card-body"><h3>GitHub</h3><p>Explore source repositories and project files from the Tech2morrow account.</p><a class="text-link" href={SITE.social.github} target="_blank" rel="noopener noreferrer">Open GitHub <Icon name="external" size={17}/></a></div></article><article class="content-card"><div class="card-visual"><span>Phone</span><Icon name="wave" size={44}/></div><div class="card-body"><h3>{SITE.phone}</h3><p>This inquiry number is preserved from the public About page on the original website.</p><a class="text-link" href={`tel:${SITE.phone.replaceAll(' ','')}`}>Call Academy4Tech <Icon name="arrow" size={17}/></a></div></article></div></div></section>
</BaseLayout>
