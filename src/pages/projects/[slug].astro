---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ContentCard from '@/components/ContentCard.astro';
import SocialShare from '@/components/SocialShare.astro';
import ArticleEnhancements from '@/components/ArticleEnhancements.astro';
import Icon from '@/components/Icon.astro';
import { isPublished } from '@/utils/content';

export async function getStaticPaths() {
  return (await getCollection('projects')).filter(isPublished).map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const all = (await getCollection('projects')).filter(isPublished);
const related = all.filter(item => item.id !== entry.id && (item.data.category === entry.data.category || item.data.tags.some(tag => entry.data.tags.includes(tag)))).slice(0, 3);
const schema = { '@context':'https://schema.org','@type':'CreativeWork',name:entry.data.title,description:entry.data.description,url:Astro.url.href,author:{'@type':'Organization',name:'Academy4Tech'},keywords:[...entry.data.technologies,...entry.data.tags].join(', ') };
---
<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.image} type="article">
  <section class="page-hero"><div class="shell"><Breadcrumbs items={[{label:'Home',href:'/'},{label:'Projects',href:'/projects'},{label:entry.data.title}]} /><div class="page-hero-grid"><div><div class="eyebrow">{entry.data.category} project</div><h1>{entry.data.title}</h1><p>{entry.data.description}</p><div class="page-meta"><span>{entry.data.difficulty}</span>{entry.data.buildTime && <span>{entry.data.buildTime}</span>}{entry.data.technologies.map(value => <span>{value}</span>)}</div></div>{entry.data.github && <a class="button" href={entry.data.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={20} /> View source on GitHub</a>}</div></div></section>
  <div class="shell article-shell"><article class="article"><p class="article-lead">This page is migrated from a public Academy4Tech project record and reorganized for clarity. Unverified build values have not been invented.</p><div class="requirements"><div class="requirement-card"><h2>Documented hardware</h2><ul>{entry.data.hardware.map(value => <li>{value}</li>)}</ul></div><div class="requirement-card"><h2>Documented software</h2><ul>{entry.data.software.map(value => <li>{value}</li>)}</ul></div></div><div class="prose"><Content /></div><SocialShare title={entry.data.title} /></article><aside class="article-aside"><nav class="toc" aria-label="On this page"><h2>On this page</h2><ul>{headings.filter(item => item.depth <= 3).map(item => <li><a href={`#${item.slug}`}>{item.text}</a></li>)}</ul></nav></aside></div>
  {related.length > 0 && <section class="section surface-section"><div class="shell"><div class="section-head"><div><div class="eyebrow">Keep building</div><h2>Related projects.</h2></div></div><div class="content-grid">{related.map(item => <ContentCard href={`/projects/${item.id}`} title={item.data.title} description={item.data.description} category={item.data.category} meta={item.data.difficulty} tags={item.data.technologies} action="View project" />)}</div></div></section>}
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script><ArticleEnhancements />
</BaseLayout>
