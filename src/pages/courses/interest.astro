<script>
  const form = document.querySelector<HTMLFormElement>('[data-interest-form]');
  const startedAtInput =
    form?.querySelector<HTMLInputElement>('[data-started-at]');
  const message =
    form?.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
  const count = document.querySelector<HTMLElement>('[data-message-count]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  const button =
    form?.querySelector<HTMLButtonElement>('[data-submit-button]');

  let formStartedAt = Date.now();

  function resetStartedAt() {
    formStartedAt = Date.now();

    if (startedAtInput) {
      startedAtInput.value = String(formStartedAt);
    }
  }

  resetStartedAt();

  message?.addEventListener('input', () => {
    if (count) {
      count.textContent = String(message.value.length);
    }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!form.reportValidity()) {
      return;
    }

    const formData = new FormData(form);
    const interestValues = formData
      .getAll('interests')
      .map(String);

    if (!interestValues.length) {
      if (status) {
        status.textContent = 'Choose at least one learning interest.';
        status.classList.remove('is-success');
        status.classList.add('is-error');
      }

      form
        .querySelector<HTMLInputElement>('input[name="interests"]')
        ?.focus();

      return;
    }

    if (
      formData.get('ageGroup') === 'under-16' &&
      formData.get('submitterRole') !== 'parent-guardian'
    ) {
      if (status) {
        status.textContent =
          'A parent or guardian must submit for a learner under 16.';
        status.classList.remove('is-success');
        status.classList.add('is-error');
      }

      form
        .querySelector<HTMLSelectElement>('select[name="submitterRole"]')
        ?.focus();

      return;
    }

    const payload: Record<
      string,
      FormDataEntryValue | FormDataEntryValue[]
    > = {
      ...Object.fromEntries(formData.entries()),
      interests: interestValues,
      startedAt: String(formStartedAt),
    };

    if (button) {
      button.disabled = true;
      button.textContent = 'Sending…';
    }

    if (status) {
      status.textContent = 'Sending your course interest…';
      status.classList.remove('is-success', 'is-error');
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify(payload),
      });

      const result: { error?: unknown; ok?: unknown } = await response
        .json()
        .catch(() => ({}));

      if (!response.ok) {
        throw new Error(
          typeof result.error === 'string'
            ? result.error
            : 'The form could not be sent. Please try again.',
        );
      }

      form.reset();
      resetStartedAt();

      if (count) {
        count.textContent = '0';
      }

      if (status) {
        status.textContent =
          'Thank you—your interests have been recorded.';
        status.classList.remove('is-error');
        status.classList.add('is-success');
      }
    } catch (error) {
      if (status) {
        status.textContent =
          error instanceof Error
            ? error.message
            : 'The form could not be sent. Please try again.';

        status.classList.remove('is-success');
        status.classList.add('is-error');
      }
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = 'Send my interest';
      }
    }
  });
</script>