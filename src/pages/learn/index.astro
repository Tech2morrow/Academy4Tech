---
import BaseLayout from '@/layouts/BaseLayout.astro';import Breadcrumbs from '@/components/Breadcrumbs.astro';import Icon from '@/components/Icon.astro';import {paths,topics} from '@/data/site';
---
<BaseLayout title="Learn Engineering" description="Explore Academy4Tech learning topics and paths across robotics, IoT, Python, electronics, AI and embedded systems.">
  <section class="page-hero"><div class="shell"><Breadcrumbs items={[{label:'Home',href:'/'},{label:'Learn'}]}/><div class="page-hero-grid"><div><div class="eyebrow">Learning system</div><h1>Build the skills behind complete systems.</h1><p>Start with one technology or follow a path that connects programming, electronics, sensing and autonomy.</p></div></div></div></section>
  <section class="section"><div class="shell"><div class="section-head"><div><div class="eyebrow">All topics</div><h2>Choose your entry point.</h2></div><p>Each topic page explains why the skill matters, the tools it connects to and where to continue.</p></div><div class="topic-grid">{topics.map(topic=><a class="topic-card" href={`/learn/${topic.slug}`}><span class="topic-icon"><Icon name={topic.icon}/></span><h3>{topic.name}</h3><p>{topic.short}</p><span class="text-link">Explore <Icon name="arrow" size={17}/></span></a>)}</div></div></section>
  <section class="section surface-section"><div class="shell"><div class="section-head"><div><div class="eyebrow">Guided routes</div><h2>Learning paths.</h2></div><p>Use these as flexible maps—not certification programs or prerequisites.</p></div><div class="path-grid">{paths.map((path,index)=><article class="path-card" data-number={`0${index+1}`}><span class="topic-icon"><Icon name={path.icon}/></span><h3>{path.name}</h3><p>{path.description}</p><div class="path-steps">{path.topics.map(slug=>{const topic=topics.find(item=>item.slug===slug);return topic&&<a href={`/learn/${slug}`}>{topic.name}</a>})}</div></article>)}</div></div></section>
</BaseLayout>
