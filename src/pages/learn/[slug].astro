---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ContentCard from '@/components/ContentCard.astro';
import Icon from '@/components/Icon.astro';
import LessonFlow from '@/components/LessonFlow.astro';
import { topics } from '@/data/site';
import { learningGuideBySlug } from '@/data/learning';
import { isPublished } from '@/utils/content';

export function getStaticPaths() {
  return topics.map((topic) => ({ params: { slug: topic.slug }, props: { topic } }));
}

const { topic } = Astro.props;
const guide = learningGuideBySlug.get(topic.slug);
const [tutorials, projects, posts] = await Promise.all([
  getCollection('tutorials'),
  getCollection('projects'),
  getCollection('blog')
]);
const terms = [topic.name.toLowerCase(), topic.slug, ...topic.tools.map((value) => value.toLowerCase())];
const matches = (item: { data: { category: string; tags: string[] } }) =>
  [item.data.category, ...item.data.tags].some((value) =>
    terms.some((term) => value.toLowerCase().includes(term) || term.includes(value.toLowerCase()))
  );
const relatedTutorials = tutorials.filter(isPublished).filter(matches).slice(0, 2);
const relatedProjects = projects.filter(isPublished).filter(matches).slice(0, 2);
const relatedPosts = posts.filter(isPublished).filter(matches).slice(0, 2);
const courseSchema = guide && {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `${topic.name} foundations`,
  description: topic.description,
  provider: { '@type': 'Organization', name: 'Academy4Tech', url: 'https://academy4tech.com' },
  educationalLevel: 'Secondary school and beginner',
  isAccessibleForFree: true,
  hasPart: guide.lessons.map((lesson, index) => ({
    '@type': 'LearningResource',
    position: index + 1,
    name: lesson.title,
    timeRequired: lesson.duration
  }))
};
---
<BaseLayout title={`Learn ${topic.name}`} description={topic.description} image={guide?.hero}>
  {courseSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)}></script>}

  <section class:list={['page-hero', guide && 'learning-hero']}>
    <div class="shell">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Learn', href: '/learn' }, { label: topic.name }]} />
      <div class="page-hero-grid">
        <div>
          <div class="eyebrow">{topic.level} · visual course</div>
          <h1>{topic.name}</h1>
          <p>{guide?.bigIdea ?? topic.description}</p>
          <div class="page-meta">
            {topic.tools.map((value) => <span>{value}</span>)}
            {guide && <span>{guide.lessons.length} sessions</span>}
          </div>
        </div>
        {guide ? (
          <figure class="learning-hero-art">
            <img src={guide.hero} alt={guide.heroAlt} width="1672" height="941" fetchpriority="high" decoding="async" />
            <figcaption>Concept overview · generated for this Academy4Tech lesson</figcaption>
          </figure>
        ) : (
          <span class="topic-icon learning-icon-fallback"><Icon name={topic.icon} size={48} /></span>
        )}
      </div>
    </div>
  </section>

  {guide ? (
    <>
      <section class="section learning-overview">
        <div class="shell">
          <div class="learning-intro-grid">
            <div>
              <div class="eyebrow">Start here</div>
              <h2>See the system, then build it.</h2>
              <p class="learning-note">{guide.studentNote}</p>
            </div>
            <div class="outcome-list">
              {guide.outcomes.map((outcome, index) => (
                <div><strong>{String(index + 1).padStart(2, '0')}</strong><span>{outcome}</span></div>
              ))}
            </div>
          </div>

          <nav class="session-map" aria-label={`${topic.name} lesson sessions`}>
            {guide.lessons.map((lesson, index) => (
              <a href={`#session-${index + 1}`}>
                <span>Session {index + 1}</span>
                <strong>{lesson.title}</strong>
                <small>{lesson.duration}</small>
              </a>
            ))}
          </nav>
        </div>
      </section>

      <section class="learning-sessions">
        <div class="shell">
          {guide.lessons.map((lesson, index) => (
            <article class="lesson-session" id={`session-${index + 1}`}>
              <header class="lesson-heading">
                <div class="lesson-number">{String(index + 1).padStart(2, '0')}</div>
                <div>
                  <div class="eyebrow">Session {index + 1} · {lesson.duration}</div>
                  <h2>{lesson.title}</h2>
                  <p class="lesson-question">{lesson.question}</p>
                </div>
              </header>

              <div class="lesson-body-grid">
                <div class="lesson-explanation">
                  <h3>Understand it</h3>
                  <p>{lesson.explanation}</p>
                </div>
                <LessonFlow steps={lesson.visual} label={`${lesson.title}: ${lesson.visual.join(' to ')}`} />
              </div>

              <div class="lesson-support-grid">
                <div class="concept-panel concept-analogy">
                  <span>Picture it</span>
                  <h3>A useful analogy</h3>
                  <p>{lesson.analogy}</p>
                </div>
                <div class="concept-panel concept-example">
                  <span>Apply it</span>
                  <h3>Worked example</h3>
                  <p>{lesson.example}</p>
                </div>
              </div>

              {lesson.code && (
                <div class="lesson-code">
                  <div><span>Example code</span><small>Read each line, predict, then run</small></div>
                  <pre><code>{lesson.code}</code></pre>
                </div>
              )}

              <div class="lesson-practice-grid">
                <div>
                  <span class="practice-label">Try it</span>
                  <ol>{lesson.activity.map((step) => <li>{step}</li>)}</ol>
                </div>
                <details class="quick-check">
                  <summary><span>Quick check</span>{lesson.check.question}</summary>
                  <p><strong>Answer:</strong> {lesson.check.answer}</p>
                </details>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section surface-section">
        <div class="shell learning-reference-grid">
          <div>
            <div class="eyebrow">Words to know</div>
            <h2>Build your vocabulary.</h2>
            <dl class="vocabulary-grid">
              {guide.vocabulary.map((item) => (
                <div><dt>{item.term}</dt><dd>{item.meaning}</dd></div>
              ))}
            </dl>
          </div>

          <aside class="learning-challenge">
            <span>Capstone challenge</span>
            <h2>{guide.challenge.title}</h2>
            <p>{guide.challenge.brief}</p>
            <h3>Build plan</h3>
            <ol>{guide.challenge.steps.map((step) => <li>{step}</li>)}</ol>
            <h3>Show your evidence</h3>
            <ul>{guide.challenge.evidence.map((item) => <li>{item}</li>)}</ul>
          </aside>
        </div>
      </section>

      {(guide.safety?.length ?? 0) > 0 && (
        <section class="section-tight">
          <div class="shell safety-panel">
            <div><div class="eyebrow">Work safely</div><h2>Before you power or move anything.</h2></div>
            <ul>{guide.safety?.map((item) => <li>{item}</li>)}</ul>
          </div>
        </section>
      )}

      <section class="section official-resources">
        <div class="shell">
          <div class="section-head">
            <div><div class="eyebrow">Keep studying</div><h2>Official documentation.</h2></div>
            <p>These lessons simplify the first ideas. Use the original documentation when building, checking details or moving to the next level.</p>
          </div>
          <div class="resource-link-grid">
            {guide.sources.map((source, index) => (
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                <span>{String(index + 1).padStart(2, '0')} · {source.publisher}</span>
                <strong>{source.title}</strong>
                <Icon name="external" size={18} />
              </a>
            ))}
          </div>
        </div>
      </section>
    </>
  ) : (
    <section class="section">
      <div class="shell">
        <div class="section-head"><div><div class="eyebrow">Learning focus</div><h2>What this topic unlocks.</h2></div><p>{topic.short} Use the connected tools below to turn the concept into measured, testable work.</p></div>
        <div class="stats-strip"><div><strong>01</strong><span>Understand the core concepts and vocabulary</span></div><div><strong>02</strong><span>Set up one dependable toolchain</span></div><div><strong>03</strong><span>Build a small, observable experiment</span></div><div><strong>04</strong><span>Integrate it into a wider system</span></div></div>
      </div>
    </section>
  )}

  {(relatedTutorials.length + relatedProjects.length + relatedPosts.length) > 0 && (
    <section class="section surface-section">
      <div class="shell">
        <div class="section-head"><div><div class="eyebrow">Continue learning</div><h2>Related Academy4Tech content.</h2></div></div>
        <div class="content-grid">
          {relatedTutorials.map((item) => <ContentCard href={`/tutorials/${item.id}`} title={item.data.title} description={item.data.description} category="Tutorial" meta={item.data.difficulty} tags={item.data.technologies} action="Read tutorial" />)}
          {relatedProjects.map((item) => <ContentCard href={`/projects/${item.id}`} title={item.data.title} description={item.data.description} category="Project" meta={item.data.difficulty} tags={item.data.technologies} action="View project" />)}
          {relatedPosts.map((item) => <ContentCard href={`/blog/${item.id}`} title={item.data.title} description={item.data.description} category="Article" meta={item.data.readingTime} tags={item.data.tags} action="Read article" />)}
        </div>
      </div>
    </section>
  )}

  <section class="section-tight">
    <div class="shell"><div class="cta-panel"><div><h2>Learn by building.</h2><p>Choose a real project, identify the smallest subsystem you can test, and document what the measurement tells you.</p></div><div class="cta-actions"><a class="button" href="/projects">Explore projects</a><a class="button button-secondary" href="/learn">Choose another topic</a></div></div></div>
  </section>
</BaseLayout>
