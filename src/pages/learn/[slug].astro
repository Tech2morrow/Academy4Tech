---
import {getCollection} from 'astro:content';import BaseLayout from '@/layouts/BaseLayout.astro';import Breadcrumbs from '@/components/Breadcrumbs.astro';import ContentCard from '@/components/ContentCard.astro';import Icon from '@/components/Icon.astro';import {topics} from '@/data/site';import {isPublished} from '@/utils/content';
export function getStaticPaths(){return topics.map(topic=>({params:{slug:topic.slug},props:{topic}}));}
const {topic}=Astro.props;
const [tutorials,projects,posts]=await Promise.all([getCollection('tutorials'),getCollection('projects'),getCollection('blog')]);
const terms=[topic.name.toLowerCase(),topic.slug,...topic.tools.map(value=>value.toLowerCase())];
const matches=(item:{data:{category:string;tags:string[]}})=>[item.data.category,...item.data.tags].some(value=>terms.some(term=>value.toLowerCase().includes(term)||term.includes(value.toLowerCase())));
const relatedTutorials=tutorials.filter(isPublished).filter(matches).slice(0,2);const relatedProjects=projects.filter(isPublished).filter(matches).slice(0,2);const relatedPosts=posts.filter(isPublished).filter(matches).slice(0,2);
---
<BaseLayout title={`Learn ${topic.name}`} description={topic.description}>
  <section class="page-hero"><div class="shell"><Breadcrumbs items={[{label:'Home',href:'/'},{label:'Learn',href:'/learn'},{label:topic.name}]}/><div class="page-hero-grid"><div><div class="eyebrow">{topic.level}</div><h1>{topic.name}</h1><p>{topic.description}</p><div class="page-meta">{topic.tools.map(value=><span>{value}</span>)}</div></div><span class="topic-icon" style="width:88px;height:88px"><Icon name={topic.icon} size={48}/></span></div></div></section>
  <section class="section"><div class="shell"><div class="section-head"><div><div class="eyebrow">Learning focus</div><h2>What this topic unlocks.</h2></div><p>{topic.short} Use the connected tools below to turn the concept into measured, testable work.</p></div><div class="stats-strip"><div><strong>01</strong><span>Understand the core concepts and vocabulary</span></div><div><strong>02</strong><span>Set up one dependable toolchain</span></div><div><strong>03</strong><span>Build a small, observable experiment</span></div><div><strong>04</strong><span>Integrate it into a wider system</span></div></div></div></section>
  {(relatedTutorials.length+relatedProjects.length+relatedPosts.length)>0&&<section class="section surface-section"><div class="shell"><div class="section-head"><div><div class="eyebrow">Continue learning</div><h2>Related Academy4Tech content.</h2></div></div><div class="content-grid">{relatedTutorials.map(item=><ContentCard href={`/tutorials/${item.id}`} title={item.data.title} description={item.data.description} category="Tutorial" meta={item.data.difficulty} tags={item.data.technologies} action="Read tutorial"/>)}{relatedProjects.map(item=><ContentCard href={`/projects/${item.id}`} title={item.data.title} description={item.data.description} category="Project" meta={item.data.difficulty} tags={item.data.technologies} action="View project"/>)}{relatedPosts.map(item=><ContentCard href={`/blog/${item.id}`} title={item.data.title} description={item.data.description} category="Article" meta={item.data.readingTime} tags={item.data.tags} action="Read article"/>)}</div></div></section>}
  <section class="section-tight"><div class="shell"><div class="cta-panel"><div><h2>Learn by building.</h2><p>Choose a real project, identify the smallest subsystem you can test, and document what the measurement tells you.</p></div><div class="cta-actions"><a class="button" href="/projects">Explore projects</a><a class="button button-secondary" href="/tutorials">Browse tutorials</a></div></div></div></section>
</BaseLayout>
