---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ContentCard from '@/components/ContentCard.astro';
import { isPublished } from '@/utils/content';
const tutorials = (await getCollection('tutorials')).filter(isPublished).sort((a,b)=>Number(b.data.featured)-Number(a.data.featured));
const categories = [...new Set(tutorials.map(item=>item.data.category))];
---
<BaseLayout title="Engineering Tutorials" description="Step-by-step Academy4Tech tutorials for Python, ROS, robotics and embedded engineering.">
  <section class="page-hero"><div class="shell"><Breadcrumbs items={[{label:'Home',href:'/'},{label:'Tutorials'}]} /><div class="page-hero-grid"><div><div class="eyebrow">Tutorial library</div><h1>Clear steps. Useful context. Less guesswork.</h1><p>Follow focused guides for software setup, robot tools and practical engineering workflows.</p></div></div></div></section>
  <section class="section"><div class="shell"><div class="filter-bar"><label for="tutorial-search">Filter tutorials</label><input id="tutorial-search" type="search" placeholder="Search tutorials or technology" data-tutorial-search /><label class="sr-only" for="tutorial-category">Category</label><select id="tutorial-category" data-tutorial-category><option value="">All categories</option>{categories.map(value=><option value={value.toLowerCase()}>{value}</option>)}</select></div><div class="content-grid">{tutorials.map(entry=><div data-tutorial-item data-category={entry.data.category.toLowerCase()} data-search={`${entry.data.title} ${entry.data.description} ${entry.data.tags.join(' ')} ${entry.data.technologies.join(' ')}`.toLowerCase()}><ContentCard href={`/tutorials/${entry.id}`} title={entry.data.title} description={entry.data.description} category={entry.data.category} meta={entry.data.difficulty} tags={entry.data.technologies} icon={entry.data.category==='Python'?'code':'nodes'} action="Read tutorial" /></div>)}</div><p class="empty-state" hidden data-tutorial-empty>No tutorials match that search.</p></div></section>
</BaseLayout>
<script>
  const filterTutorials = () => { const search=document.querySelector('[data-tutorial-search]');const categorySelect=document.querySelector('[data-tutorial-category]');const q=search instanceof HTMLInputElement?search.value.toLowerCase():'';const category=categorySelect instanceof HTMLSelectElement?categorySelect.value:'';let visible=0; document.querySelectorAll('[data-tutorial-item]').forEach(item=>{if(!(item instanceof HTMLElement))return;const show=(!q||item.dataset.search?.includes(q))&&(!category||item.dataset.category===category);item.hidden=!show;if(show)visible++;});const empty=document.querySelector('[data-tutorial-empty]');if(empty instanceof HTMLElement)empty.hidden=visible>0;};
  document.querySelector('[data-tutorial-search]')?.addEventListener('input',filterTutorials);document.querySelector('[data-tutorial-category]')?.addEventListener('change',filterTutorials);
</script>
